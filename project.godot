; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RPG do Reino"
config/description="RPG de ação 2D top-down no reino de Aurora: raças, classes, fama e Colossais."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.055, 0.063, 0.09, 1)
boot_splash/show_image=false
config/icon="res://assets/game/ui/icon.png"

[autoload]

ManusFontTheme="*res://autoload/manus_font_theme.gd"
SaveGame="*res://autoload/save_game.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="RPG do Reino"

[editor]

import/use_multiple_threads=false

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

